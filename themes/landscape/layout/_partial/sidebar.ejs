<aside id="sidebar"<% if (theme.sidebar === 'bottom'){ %> class="outer"<% } %>>

  <!-- Geek Terminal Card -->
  <div id="terminal-card">
    <div class="terminal-header">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
      <span class="terminal-title">guest@zzl-blog ~ $</span>
    </div>
    <div class="terminal-body">
      <div class="terminal-line">
        <span class="prompt">$</span> <span class="cmd">whoami</span>
      </div>
      <div class="terminal-output">
        <div class="profile-card">
          <img src="/images/avatar.jpg" class="profile-avatar" alt="avatar" onerror="this.parentElement.parentElement.style.display='none'" />
          <div class="profile-info">
            <span class="profile-name"><%= config.author %></span>
            <span class="profile-title">Java Backend & AI Agent</span>
          </div>
        </div>
      </div>
      <div class="terminal-line">
        <span class="prompt">$</span> <span class="cmd">cat /etc/motd</span>
      </div>
      <div class="terminal-output motd">
        <span class="brace">{</span> code & chaos <span class="brace">}</span>
      </div>
      <div class="terminal-line typing">
        <span class="prompt">$</span> <span class="cursor">_</span>
      </div>
    </div>
  </div>

  <!-- Tech Stack Badges -->
  <div id="tech-badges">
    <span class="badge">Java</span>
    <span class="badge">Spring Boot</span>
    <span class="badge">JVM</span>
    <span class="badge">MySQL</span>
    <span class="badge">Redis</span>
    <span class="badge">RabbitMQ</span>
    <span class="badge">Elasticsearch</span>
    <span class="badge">Multi-Agent</span>
    <span class="badge">RAG</span>
    <span class="badge">MCP</span>
  </div>

  <% theme.widgets.forEach(function(widget){ %>
    <%- partial('_widget/' + widget) %>
  <% }) %>
</aside>
